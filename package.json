{
  "name": "youtube-player",
  "version": "1.1.0",
  "description": "YouTube player desktop app",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win --x64",
    "build:dir": "electron-builder --win --x64 --dir"
  },
  "build": {
    "appId": "com.youtubeplayer.app",
    "productName": "YouTube Player",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/youtube-dl-exec/**/*",
      "node_modules/ffmpeg-static/**/*"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.2.7",
    "ffmpeg-static": "^5.3.0",
    "youtube-dl-exec": "^3.1.6"
  }
}
